# dependencies
node_modules/

# next.js
.next/
out/

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# db backups -- these hold real client data. db/backup.mjs writes OUTSIDE the
# repo by default; this covers anyone who overrides BACKUP_DIR back into it.
db/backups/

# Real client/business data. Reference only, never in git history -- private
# repo or not. NDA-covered material in a repo is still NDA-covered material,
# and history is forever.
/Reference/
*Job Spec Fields*.csv
*BOQ*.xlsx
~$*.xlsx

# Vercel CLI
.vercel/

# Neon CLI local context
.neon

# Env values staged for pasting into a hosting provider. Real secrets, and
# NOT covered by the .env*.local pattern above -- which is exactly how the
# first version of this file lost these three lines to a `cp -R chassis/.`
# and left a secrets file untracked-but-committable.
.env.vercel*

# Reference material: real client documents, read-only, never committed.
/docs/docs for building/

# Reference material: real client documents, read-only, never committed.
/docs/docs for building/

# Generated working documents (tools/tgq-checklist.mjs). The generator is the
# artefact worth keeping; a filled-in copy comes back by email, not by git.
/out/

# Documents the demo writes for somebody to upload live on a call
# (tools/qa-demo-project.ts). Generated, never source.
demo-documents/
