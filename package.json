{
  "name": "spec-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "checks": "echo 'checks: lint, typecheck, the four tiers with the DATABASE TIER REQUIRED, then next build. The build overwrites .next, so stop any `npm run dev` in this directory first or its dev server serves 404s until you restart it.' && npm run lint && npm run typecheck && REQUIRE_DB_TESTS=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run && npm run build",
    "checks:shared": "echo 'checks with the fork pool capped at 4, for a machine already running another suite. The cap lives in vitest.config.ts because --maxWorkers=4 alone conflicts with vitest 2.1 default minWorkers and runs zero tests.' && VITEST_MAX_FORKS=4 npm run checks",
    "dev:local": "node --env-file=.env.localstack.local tools/localstack/dev.mjs",
    "checks:local": "node --env-file=.env.localstack.local tools/localstack/checks.mjs",
    "db:migrate:local": "node --env-file=.env.localstack.local db/run-migrations.mjs",
    "db:seed:local": "node --env-file=.env.localstack.local db/run-seed.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local db/run-migrations.mjs",
    "db:seed": "node --env-file-if-exists=.env.local db/run-seed.mjs",
    "db:backup": "node --env-file-if-exists=.env.local db/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.local db/restore.mjs",
    "hash-password": "node tools/hash-password.mjs",
    "create-user": "node tools/create-user.mjs",
    "db:backfill-answers": "tsx --env-file-if-exists=.env.local db/backfill-answers.ts",
    "db:backfill-snapshots": "tsx --env-file-if-exists=.env.local db/backfill-snapshots.ts",
    "db:qa-clean": "node --env-file-if-exists=.env.local tools/qa-clean.mjs",
    "db:backfill-finishes": "tsx --env-file-if-exists=.env.local db/backfill-finishes.ts",
    "dump:drawings": "tsx --env-file-if-exists=.env.local tools/dump-drawing-run.ts",
    "vocab:gap": "tsx --env-file-if-exists=.env.local tools/vocab-gap.ts",
    "palette:gap": "tsx --env-file-if-exists=.env.local tools/palette-gap.ts",
    "boq:gap": "tsx tools/boq-gap.ts",
    "spec:gap": "node --env-file=.env.localstack.local tools/localstack/tool.mjs tools/spec-gap.ts",
    "qa:fake-inbox": "tsx --env-file-if-exists=.env.local tools/qa-fake-inbox.ts",
    "qa:levels": "tsx --env-file-if-exists=.env.local tools/qa-levels-and-designer.ts",
    "qa:demo": "tsx --env-file-if-exists=.env.local tools/qa-demo-project.ts",
    "measure:drawings": "tsx --env-file-if-exists=.env.local tools/measure-drawing-reading.ts",
    "measure:outstanding": "tsx --env-file-if-exists=.env.local tools/measure-outstanding.ts",
    "measure:screens": "tsx --env-file-if-exists=.env.local tools/measure-screens.ts",
    "reread:drawings": "tsx --env-file-if-exists=.env.local tools/reread-drawings.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "^2.6.1",
    "@vercel/queue": "^0.4.0",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "next": "^15.1.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "postal-mime": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
