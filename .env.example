# Copy to .env.local and fill in. NEVER commit .env.local.
# Each variable carries its policy, not just its name.

# Which deployment this is: development | staging | pilot | production.
# The app refuses to start if this is unset, or if it disagrees with
# DATABASE_ENVIRONMENT below (src/lib/env.ts).
#
# `pilot` is the stable build Matthew works on: its own Vercel project, its own
# Neon project, its own blob store. It is NOT production — every non-production
# behaviour stays on — but it holds real work, so it pairs with nothing else
# and nothing else pairs with it. It also prints its own chip and title marker
# (PILOT, not STAGING), because two deployments whose chips read the same word
# make a screenshot useless for saying which build it came from.
APP_ENV=development

# Which database you BELIEVE DATABASE_URL points at: sandbox | pilot |
# production. Deliberately checked independently of DATABASE_URL's contents —
# never inferred by guessing from the connection string. It is a declaration;
# the scripts print the resolved host so a human can check the declaration.
#
# `pilot` and `production` each require their OWN flag on any db script that
# writes — `--yes-pilot` and `--yes-production`, never one covering both. The
# accident guarded against is a mistyped --env-file while switching between
# sandbox and pilot in one sitting. `npm run db:qa-clean` and the `qa:*`
# scripts refuse anything but sandbox outright: a sweep and an invented project
# have no business anywhere else.
DATABASE_ENVIRONMENT=sandbox

# Postgres. Neon project `SpecBuilder`, branch `sandbox`, London
# (aws-eu-west-2). The app's serverless driver wants the POOLED string; the
# db/*.mjs scripts need a real session for `begin` and `DO` blocks, so they
# want the DIRECT one. Neon's sandbox endpoint is already direct — the pooled
# host is the same name with `-pooler` before `.c-2`.
#
# The project's other branch is called `root`, not `production`. It is the
# parent of `sandbox` and nothing should connect to it. Production, when it
# exists, will be a SEPARATE Neon project. So is PILOT — a separate project and
# not a branch of `SpecBuilder`, because a branch shares the parent's history
# and a restore into it is a trap. Neon named the pilot project's own default
# branch `production`; that is Neon's label, NOT this app's environment, the
# same way the sandbox project's parent branch is called `root`.
#
# NEVER run `neon link` or `neon deploy` without --no-env-pull. They rewrite
# DATABASE_URL in this file by default and say nothing, so it points at another
# database while DATABASE_ENVIRONMENT still declares this one. See
# docs/environments.md.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session (users sign in again;
# nothing is lost).
AUTH_SECRET=

# Anthropic API, for document extraction (M2 — nothing uses it yet). Billed
# per token, separately from any claude.ai seat subscription.
#
# Zero-data-retention was CLEARED on 2026-09-13: client specification documents
# may go to the model. The key is set locally and in Vercel staging as of
# 2026-09-13 (verified in the project's environment variables). Who OWNS the
# Anthropic Console account is still unnamed — that is the remaining gap, and it
# matters because account-level retention settings live there, not here.
ANTHROPIC_API_KEY=

# Vercel Blob. Not provisioned yet — first needed at M1, where the BOQ import
# is an upload. `handleUpload` reads this when called, not at import, so the
# app boots and signs in without it. Injected automatically on Vercel once a
# store is connected; local dev must set it explicitly. The store is PRIVATE: server-side reads send this as a bearer
# token — possession of a blob URL is not access.
BLOB_READ_WRITE_TOKEN=

# The blob store this app is allowed to read from. Registration checks an
# uploaded blob belongs to THIS store before fetching it with the bearer token
# above — possession of a URL is not access, and a URL supplied by a client is
# not trusted.
BLOB_STORE_ID=

# Stable HTTPS URL for callbacks from external services.
APP_BASE_URL=http://localhost:3000

# Outbound email. "disabled" means no sending code path is active.
# Drafts are generated for a human to send; this never becomes "enabled"
# without an explicit, documented safety design.
EMAIL_MODE=disabled

# Inbound mailbox ingestion (read-only). Disabled until the mailbox and scoped
# credentials are explicitly approved.
MAIL_INGESTION_MODE=disabled

# Bearer secret for scheduled jobs (16+ random chars). Cron and queue routes
# are not session routes and must validate their own secret.
CRON_SECRET=

# --- app-specific ----------------------------------------------------------

# Microsoft Graph, for read-only ingestion of the shared project inbox
# (p17231@benwhistler.com). M5. Read-only forever: this app never sends from,
# or writes to, a mailbox. Entra and Exchange grants COMBINE rather than narrow
# each other — prove the scoping with InScope=True on the target mailbox and
# InScope=False on an unrelated one before enabling. See docs/integration.md.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=

# Capsule CRM — project contacts, READ-ONLY.
# Absent means the "Find in Capsule" search answers 503 with the reason and the
# manual contact form keeps working. This app never creates or updates a party
# in Capsule: src/lib/capsule.ts has one HTTP helper and it hard-codes GET.
CAPSULE_API_TOKEN=
