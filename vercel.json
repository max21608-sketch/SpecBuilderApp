{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "lhr1"
  ],
  "functions": {
    "src/app/api/queues/[topic]/route.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "document-extraction",
          "consumer": "document-extraction-worker",
          "retryAfterSeconds": 60,
          "maxDeliveries": 4
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/graph-renew",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/graph-delta",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sweep-reads",
      "schedule": "17 * * * *"
    }
  ]
}
