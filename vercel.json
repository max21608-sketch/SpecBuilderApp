{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "functions": {
    "src/app/api/queues/[topic]/route.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "document-extraction",
          "consumer": "document-extraction-worker",
          "retryAfterSeconds": 60,
          "maxDeliveries": 4
        }
      ]
    }
  }
}
