# The LOCAL STACK (docs/environments.md, "The local stack"): the whole app on
# one Mac, against a local Postgres and a folder standing in for Vercel Blob.
# Copy to .env.localstack.local — or run `node tools/localstack/init-env.mjs`,
# which writes it with a fresh secret — and never point it anywhere but here.
# Every local-stack command names this file itself; none of them reads
# .env.local, which points at the sandbox.

# The local-stack guard (tools/localstack/guard.mjs) refuses unless all three
# hold: LOCAL_STACK=1, APP_ENV=development, and a DATABASE_URL host of localhost.
LOCAL_STACK=1
APP_ENV=development
# src/lib/env.ts pairs development with sandbox; the HOST is what makes it local.
DATABASE_ENVIRONMENT=sandbox
DATABASE_URL=postgres://<you>@localhost:5432/specbuilder_local

AUTH_SECRET=<32+ random characters>
# Copied from .env.local by init-env.mjs, which reads that one key and nothing else.
ANTHROPIC_API_KEY=

# The fake store. The id must start with `localstack`; the secret is anything.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_localstack_<random>
# Where the stack server listens, and where the SDK is told the Blob API is.
LOCAL_STACK_PORT=3101
VERCEL_BLOB_API_URL=http://127.0.0.1:3101/api
# The browser's copy. It MUST start with http://localhost: @vercel/blob streams
# an upload body otherwise, and Chrome refuses a streamed body over HTTP/1.1
# (net::ERR_ALPN_NEGOTIATION_FAILED).
NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:3101/api
# Copies of real client documents land here. Outside the repo, always.
LOCAL_BLOB_DIR=/Users/<you>/dev/localstack/blob

APP_BASE_URL=http://localhost:3100
EMAIL_MODE=disabled
MAIL_INGESTION_MODE=disabled
CRON_SECRET=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
CAPSULE_API_TOKEN=
